<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>EcoMarketTool</AssemblyName>
    <Product>EcoMarketTool</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>EcoMarketTool</RootNamespace>

<!-- ====================================================== -->
<!-- DEVELOPMENT MACHINE                                    -->
<!-- Uncomment ONE EcoProjectPath.                                 -->
<!-- ====================================================== -->
  
    <!-- TOWER -->
  <EcoProjectPath>L:\Unity\EcoMarketTool</EcoProjectPath>
  <EcoGamePath>S:\SteamLibrary\steamapps\common\Eco</EcoGamePath>

  <!-- LAPTOP -->
  <EcoProjectPath>L:\Unity\EcoMarketTool</EcoProjectPath>
  <!--   <EcoGamePath>C:\Program Files (x86)\Steam\steamapps\common\Eco</EcoGamePath> -->
  
  <!-- ====================================================== -->
  <!-- DERIVED PATHS - normally do not change these.          -->
  <!-- ====================================================== -->
  <BepInExPath>$(EcoGamePath)\BepInEx</BepInExPath>
  <InteropPath>$(BepInExPath)\interop</InteropPath>
  <PluginPath>$(BepInExPath)\plugins\EcoMarketTools</PluginPath>
  
  </PropertyGroup>  
  
  <ItemGroup>
  <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
    <_Parameter1>EcoProjectPath</_Parameter1>
    <_Parameter2>$(EcoProjectPath)</_Parameter2>
  </AssemblyAttribute>
</ItemGroup>
  
  

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />

  <Reference Include="Eco.Client">
    <HintPath>$(BepInExPath)\interop\Eco.Client.dll</HintPath>
    <Private>false</Private>
  </Reference>

  <Reference Include="Eco.Client.Utils">
    <HintPath>$(BepInExPath)\interop\Eco.Client.Utils.dll</HintPath>
    <Private>false</Private>
  </Reference>

  <Reference Include="Eco.Shared">
    <HintPath>$(BepInExPath)\interop\Eco.Shared.dll</HintPath>
    <Private>false</Private>
  </Reference>

  <Reference Include="Il2Cppmscorlib">
    <HintPath>$(BepInExPath)\interop\Il2Cppmscorlib.dll</HintPath>
    <Private>false</Private>
  </Reference>

  <Reference Include="UnityEngine.CoreModule">
    <HintPath>$(BepInExPath)\interop\UnityEngine.CoreModule.dll</HintPath>
    <Private>false</Private>
  </Reference>	
	
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Web\Static\" />
  </ItemGroup>
  
<ItemGroup>
  <EmbeddedResource Include="Web\Static\index.html">
    <LogicalName>EcoMarketTools.Web.Static.index.html</LogicalName>
  </EmbeddedResource>

  <EmbeddedResource Include="Web\Static\app.js">
    <LogicalName>EcoMarketTools.Web.Static.app.js</LogicalName>
  </EmbeddedResource>
  
   <EmbeddedResource Include="Web\Static\transport.js">
    <LogicalName>EcoMarketTools.Web.Static.transport.js</LogicalName>
  </EmbeddedResource>

  <EmbeddedResource Include="Web\Static\style.css">
    <LogicalName>EcoMarketTools.Web.Static.style.css</LogicalName>
  </EmbeddedResource>
</ItemGroup>

</Project>